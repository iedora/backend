<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Framework.Media</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The service hosts minimal-API endpoints, so it needs the ASP.NET shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic: no iedora/domain references. The uploader's tenant comes from the JWT "tid" claim. -->
    <ProjectReference Include="..\..\Web\Framework.Web\Framework.Web.csproj" />
    <ProjectReference Include="..\..\Storage\Framework.Storage\Framework.Storage.csproj" />
  </ItemGroup>

  <!-- The Web SDK's implicit global usings (this is a plain SDK lib that hosts ASP.NET endpoints). -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
