<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Framework.Maintenance</RootNamespace>

    <!-- Standalone, generic — structured like a NuGet library (packable). -->
    <IsPackable>true</IsPackable>
    <PackageId>Framework.Maintenance</PackageId>
    <Authors>iedora</Authors>
    <Description>Periodic retention sweeps for background workers: register IRetentionSweep implementations (each deletes rows past a retention window) and a single hosted service runs them all on a fixed interval, isolating failures and counting pruned rows via OpenTelemetry. Storage-agnostic; multi-replica-safe when sweeps are idempotent WHERE-bounded deletes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Framework.Maintenance.Tests" />
  </ItemGroup>

</Project>
