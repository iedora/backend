<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Framework.Storage</RootNamespace>

    <!-- Standalone, generic — structured like a NuGet library (packable). -->
    <IsPackable>true</IsPackable>
    <PackageId>Framework.Storage</PackageId>
    <Authors>iedora</Authors>
    <Description>Reusable object storage: an IObjectStore abstraction + a local-disk implementation bound from a "Storage" config section. Transport only — swap in S3/R2/MinIO behind the same interface.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
