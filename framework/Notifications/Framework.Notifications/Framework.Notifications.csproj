<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Framework.Notifications</RootNamespace>
  </PropertyGroup>
  <!-- Generic notification-delivery service: consumes EmailRequested via its own inbox and delivers
       over SMTP. Non-web (no endpoints) — the worker drains it, like a channel dispatcher. Reusable
       across services; nothing iedora-specific. -->
  <ItemGroup>
    <ProjectReference Include="..\Framework.Notifications.Contracts\Framework.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\Inbox\Framework.Inbox\Framework.Inbox.csproj" />
    <ProjectReference Include="..\..\Outbox\Framework.Outbox\Framework.Outbox.csproj" />
    <ProjectReference Include="..\..\Email\Framework.Email\Framework.Email.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
