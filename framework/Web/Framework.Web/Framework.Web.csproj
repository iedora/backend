<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Framework.Web</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Framework.Web</PackageId>
    <Authors>iedora</Authors>
    <Description>Reusable ASP.NET Core minimal-API helpers: ProblemResults maps ErrorOr results to RFC 9457 ProblemDetails; RequestMeta reads client metadata from HttpContext.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core shared framework (IResult / TypedResults / ProblemDetails / HttpContext). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" />
    <ProjectReference Include="..\..\Commands\Framework.Commands\Framework.Commands.csproj" />
  </ItemGroup>

</Project>
