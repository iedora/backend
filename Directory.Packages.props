<Project>

  <!-- Central Package Management: every NuGet version lives here, once. Projects reference
       packages by name only (no Version=), so bumps happen in one place and Renovate has a
       single file to update. https://learn.microsoft.com/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive packages to the central versions too — the idiomatic way to fix a
         vulnerable transitive (e.g. Microsoft.OpenApi) without a placeholder direct reference. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Result pattern (no exceptions/null for expected failures) — maps error types to
         HTTP status via our own ProblemDetails mapper; no transitive ASP.NET coupling. -->
    <PackageVersion Include="ErrorOr" Version="2.1.1" />

    <!-- SMTP email (MailKit; System.Net.Mail.SmtpClient is soft-deprecated) — the sink for the
         transactional outbox that delivers password-reset mail. -->
    <PackageVersion Include="MailKit" Version="4.17.0" />

    <!-- ASP.NET Core 10 — auth (Identity, JwtBearer, OpenAPI doc gen) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <!-- Concrete DI container for tests that build their own ServiceProvider without EF (which would
         otherwise transitively supply it). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />

    <!-- Test diamond: MSTest (via the MSTest.Sdk project SDK, pinned in global.json) +
         WebApplicationFactory + Testcontainers (integration base), Respawn (state reset),
         Npgsql (Respawn connection), Aspire.Hosting.Testing (e2e), fake clock. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <!-- Direct override for the vulnerable transitive Microsoft.OpenApi 2.0.0 that
         AspNetCore.OpenApi drags in (GHSA-v5pm-xwqc-g5wc, patched 2.7.5). Latest 2.x. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />

    <!-- Aspire 13 — orchestration + Npgsql integration -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />

    <!-- ServiceDefaults — resilience, service discovery, OpenTelemetry -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <!-- In-memory exporter — test-only, asserts the ServiceDefaults wildcard actually exports app signals. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.16.0" />

    <!-- Admin dashboard (Blazor): a typed API client generated from openapi/Iedora.Api.json by
         Refitter's source generator, over Refit + IHttpClientFactory. -->
    <PackageVersion Include="Refit.HttpClientFactory" Version="13.1.0" />
    <PackageVersion Include="Refitter.SourceGenerator" Version="2.1.0" />
    <!-- Dashboard component + handler tests: bUnit renders Razor components; NSubstitute mocks the
         generated API client. -->
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

</Project>
