<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LangVersion omitted: net10.0 defaults to C# 14. -->
    <!-- Relaxed during the Aspire+Identity rebuild; the scaffolded AppHost/ServiceDefaults
         template code isn't warning-clean under strict mode. Re-enable for our own code later. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace Condition="'$(RootNamespace)' == ''">Iedora.Api</RootNamespace>

    <!-- AD0001 = "an analyzer threw an exception" — a tooling crash, never a code diagnostic. The
         ASP.NET RouteHandlerAnalyzer NREs on route handlers defined inside generic helper methods
         (our MapCommandStatus<TContext>). Suppress the meta-warning; the code compiles + runs fine. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>

    <!-- Vulnerability auditing runs transitive-wide by default on net10 (NuGetAuditMode=all).
         We only add the non-default part: promote every advisory (NU1901 low → NU1904 critical)
         to a build ERROR, so the next NU1903-style transitive vuln fails the build instead of
         scrolling past as a warning. Set <NuGetAuditMode>direct</NuGetAuditMode> per-project to relax. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
