<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iedora.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Iedora.ServiceDefaults\Iedora.ServiceDefaults.csproj" />
    <!-- Generic app worker: references each feature MODULE (bringing its DbContext, handlers +
         dispatch registration) and calls only their outbox-dispatch composition. It maps no
         endpoints, so it runs no web surface even though the modules are web-capable. -->
    <ProjectReference Include="..\Iedora.Identity\Iedora.Identity.csproj" />
    <ProjectReference Include="..\Iedora.Menus\Iedora.Menus.csproj" />
    <ProjectReference Include="..\Iedora.Tenancy\Iedora.Tenancy.csproj" />
    <ProjectReference Include="..\..\framework\Notifications\Framework.Notifications\Framework.Notifications.csproj" />
  </ItemGroup>

</Project>
