<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iedora.Contracts</RootNamespace>
  </PropertyGroup>

  <!-- The inter-module contract layer: ONLY the public interfaces + DTOs modules call each other
       through. No dependencies, no implementations — so a module referencing this can reach another
       module's surface without seeing (or being able to touch) that module's internals. -->

</Project>
