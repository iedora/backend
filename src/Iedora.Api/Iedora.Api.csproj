<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit the OpenAPI document at build time (no running server / DB needed), so the
         frontend's TypeScript client is generated + drift-checked from a committed
         artifact. Lands in backend/openapi/ next to the other cross-cutting contracts. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Iedora.ServiceDefaults\Iedora.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Iedora.Data\Iedora.Data.csproj" />
    <ProjectReference Include="..\Iedora.Messaging\Iedora.Messaging.csproj" />
    <ProjectReference Include="..\Iedora.Tenancy\Iedora.Tenancy.csproj" />
    <ProjectReference Include="..\Iedora.Contracts\Iedora.Contracts.csproj" />
    <ProjectReference Include="..\..\framework\Outbox\Framework.Outbox\Framework.Outbox.csproj" />
    <ProjectReference Include="..\..\framework\Commands\Framework.Commands\Framework.Commands.csproj" />
    <ProjectReference Include="..\..\framework\Web\Framework.Web\Framework.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in OpenAPI document generation (net10) + the build-time emitter tool. Versions
         are centralized in Directory.Packages.props; the vulnerable transitive Microsoft.OpenApi
         2.0.0 (GHSA-v5pm-xwqc-g5wc) is pinned to 2.9.0 there via transitive pinning. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- ASP.NET Core Identity stores + the Aspire Npgsql integration (DbContext + health checks
         + DB telemetry). Access tokens are ES256 JWTs validated by the JwtBearer handler. The
         EF model + migrations live in Iedora.Data. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- Result pattern for expected failures (invalid credentials, token reuse, wrong password). -->
    <PackageReference Include="ErrorOr" />
    <!-- SMTP email sink for the outbox (password-reset mail). -->
    <PackageReference Include="MailKit" />
  </ItemGroup>

</Project>
