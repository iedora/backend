<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iedora.Dashboard</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Blazor WASM Release trims IL by default, which stripped metadata the form pages need at
         runtime: the published build threw an unhandled exception on any page with a <form> (Users,
         Directory, QR) while `dotnet run` (untrimmed) worked. Disable trimming — this is a low-traffic
         admin tool, so the larger download is a fine trade for correctness. Re-enable only after
         auditing dynamic/reflection access with the trimmer warnings. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Refitter.SourceGenerator" />
  </ItemGroup>

  <ItemGroup>
    <!-- The auth vocabulary (Roles.Admin) — the only shared type; the rest of the API is reached over
         HTTP via the generated client, exactly like the front-office will consume it. -->
    <ProjectReference Include="..\Iedora.Identity.Contracts\Iedora.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Refitter reads this settings file and generates the typed client from the API's OpenAPI doc. -->
    <AdditionalFiles Include="Api\iedora-api.refitter" />
  </ItemGroup>

</Project>
