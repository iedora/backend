<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iedora.Dashboard</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire defaults (OpenTelemetry, health, resilience) — same as every other service. -->
    <ProjectReference Include="..\..\Iedora.ServiceDefaults\Iedora.ServiceDefaults.csproj" />
    <!-- The auth vocabulary (Roles.Admin / Policies.Admin) — the only cross-project type the
         dashboard reuses; the rest of the API it reaches over HTTP via the generated client. -->
    <ProjectReference Include="..\Iedora.Identity.Contracts\Iedora.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Refitter.SourceGenerator" />
  </ItemGroup>

  <ItemGroup>
    <!-- Refitter reads this settings file and generates the typed client from the API's OpenAPI doc. -->
    <AdditionalFiles Include="Api\iedora-api.refitter" />
  </ItemGroup>

</Project>
