@* Reusable search box: a Mud text field + button that reports the query on Enter or click. Directory
   and Users both use it; the page decides what OnSearch does (typically reflect it in the URL). *@
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="_q" Placeholder="@Placeholder" Immediate="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnKeyUp="OnKeyUp" Style="max-width:360px; flex:1" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Search">Search</MudButton>
</MudStack>

@code {
    [Parameter] public string? Query { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search…";
    [Parameter, EditorRequired] public EventCallback<string> OnSearch { get; set; }

    private string _q = "";

    protected override void OnParametersSet() => _q = Query ?? "";

    private Task Search() => OnSearch.InvokeAsync(_q);

    private Task OnKeyUp(KeyboardEventArgs e) => e.Key == "Enter" ? Search() : Task.CompletedTask;
}
