@using Iedora.Dashboard.Api

@if (Rows.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Empty</MudText>
}
else
{
    <MudTable Items="Rows" Hover="true" Dense="true" Outlined="true" Elevation="0">
        <HeaderContent>
            <MudTh>Restaurant</MudTh>
            <MudTh>Slug</MudTh>
            <MudTh Style="text-align:right">Menus</MudTh>
            <MudTh Style="text-align:right">Items</MudTh>
            <MudTh Style="text-align:right">Views · 30d</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Restaurant"><MudLink Href="@($"/restaurants/{context.Id}")">@context.Name</MudLink></MudTd>
            <MudTd DataLabel="Slug" Style="color:var(--mud-palette-text-secondary)">@context.Slug</MudTd>
            <MudTd DataLabel="Menus" Style="text-align:right">@context.Menus</MudTd>
            <MudTd DataLabel="Items" Style="text-align:right">@context.Items</MudTd>
            <MudTd DataLabel="Views · 30d" Style="text-align:right">@context.Views30d</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter, EditorRequired] public ICollection<StaffRestaurantRow> Rows { get; set; } = default!;
    [Parameter] public string Empty { get; set; } = "No restaurants.";
}
