@typeparam T
@* Loading / error / loaded states for an async API read, so pages don't repeat the boilerplate.
   ChildContent renders the loaded value (and owns its own empty-state); to refetch (e.g. after a
   search) set Key to the query — it reloads whenever Key changes. *@
@if (Error is not null)
{
    <p class="error" role="alert">@Error</p>
}
else if (Value is null)
{
    <p class="muted">@LoadingText</p>
}
else
{
    @ChildContent(Value)
}

@code {
    [Parameter, EditorRequired] public Func<Task<T>> Load { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<T> ChildContent { get; set; } = default!;
    [Parameter] public string LoadingText { get; set; } = "Loading…";
    /// <summary>Refetch whenever this changes (e.g. a search query). Loads once on first render.</summary>
    [Parameter] public object? Key { get; set; }

    public T? Value { get; private set; }
    public string? Error { get; private set; }

    private bool _loaded;
    private object? _lastKey;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && Equals(Key, _lastKey)) return;
        _loaded = true;
        _lastKey = Key;
        await ReloadAsync();
    }

    /// <summary>Fetch (or refetch) — shows the loading state, then the value, or the described error.</summary>
    public async Task ReloadAsync()
    {
        Value = default;
        Error = null;
        StateHasChanged();
        try { Value = await Load(); }
        catch (Exception ex) { Error = ApiError.Describe(ex); }
    }
}
