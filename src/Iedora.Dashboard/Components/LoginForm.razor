@using System.ComponentModel.DataAnnotations
@* Idiomatic sign-in form: DataAnnotations validate before submit (an empty or malformed email is
   caught client-side), and OnValidSubmit only fires when the model is valid. The parent owns the
   busy/error UI outside this component. *@
<EditForm Model="_model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <label>
        Email
        <InputText type="email" autocomplete="username" @bind-Value="_model.Email" />
    </label>
    <label>
        Password
        <InputText type="password" autocomplete="current-password" @bind-Value="_model.Password" />
    </label>
    <button type="submit">Sign in</button>
</EditForm>

@code {
    [Parameter, EditorRequired] public EventCallback<(string Email, string Password)> OnSubmit { get; set; }

    private readonly Credentials _model = new();

    private Task Submit() => OnSubmit.InvokeAsync((_model.Email, _model.Password));

    private sealed class Credentials
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}
