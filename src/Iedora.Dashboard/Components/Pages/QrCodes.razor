@page "/qr-codes"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api

<PageTitle>QR codes — iedora admin</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">QR stickers</MudText>

<MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudNumericField T="int" @bind-Value="mintCount" Min="1" Max="500" Label="Count"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px" />
        <MudTextField @bind-Value="mintLabel" Label="Label (optional)"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MintAsync" Disabled="busy"
                   StartIcon="@Icons.Material.Filled.Add">Mint</MudButton>
    </MudStack>
</MudPaper>

@if (message is not null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@message</MudAlert>
}

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@error</MudAlert>
}
else if (data is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (data.Codes.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No stickers yet — mint some above.</MudText>
}
else
{
    <MudTable Items="data.Codes" Hover="true" Dense="true" Outlined="true" Elevation="0">
        <HeaderContent>
            <MudTh>Code</MudTh>
            <MudTh>Restaurant</MudTh>
            <MudTh>Label</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code"><code>@context.Code</code></MudTd>
            <MudTd DataLabel="Restaurant">
                @if (context.RestaurantId is not null)
                {
                    <span>@context.RestaurantName <span style="color:var(--mud-palette-text-secondary)">(@context.RestaurantSlug)</span></span>
                }
                else
                {
                    <span style="color:var(--mud-palette-text-secondary)">—</span>
                }
            </MudTd>
            <MudTd DataLabel="Label" Style="color:var(--mud-palette-text-secondary)">@context.Label</MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                    @if (context.RestaurantId is null)
                    {
                        <MudTextField T="string" Value="@bindIds.GetValueOrDefault(context.Code)"
                                      ValueChanged="v => bindIds[context.Code] = v ?? string.Empty" Immediate="true"
                                      Placeholder="restaurant id" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px" />
                        <MudButton Size="Size.Small" Disabled="busy" OnClick="() => BindAsync(context.Code)">Bind</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Disabled="busy" OnClick="() => UnbindAsync(context.Code)">Unbind</MudButton>
                    }
                    <MudButton Size="Size.Small" Color="Color.Error" Disabled="busy" OnClick="() => DeleteAsync(context.Code)">Delete</MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-3">
        <MudButton Disabled="@(offset == 0 || busy)" OnClick="PrevAsync" StartIcon="@Icons.Material.Filled.ChevronLeft">Prev</MudButton>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@(offset + 1)–@(offset + data.Codes.Count) of @data.Total</MudText>
        <MudButton Disabled="@(offset + PageSize >= data.Total || busy)" OnClick="NextAsync" EndIcon="@Icons.Material.Filled.ChevronRight">Next</MudButton>
    </MudStack>
}

@code {
    private const int PageSize = 50;

    private QrCodeListResponse? data;
    private string? error;
    private string? message;
    private bool busy;
    private int offset;
    private int mintCount = 10;
    private string mintLabel = "";
    private readonly Dictionary<string, string> bindIds = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try { data = await Api.ListQrCodes(PageSize, offset); }
        catch (Exception ex) { error = ApiError.Describe(ex); }
    }

    private async Task MintAsync()
    {
        busy = true;
        error = null;
        message = null;
        try
        {
            var result = await Api.CreateQrCodes(new CreateQrRequest
            {
                Count = mintCount,
                Label = mintLabel.Trim(), // the API treats a blank label as none
            });
            message = $"Minted {result.Inserted} sticker(s).";
            offset = 0; // newest land on the first page
            await LoadAsync();
        }
        catch (Exception ex) { error = ApiError.Describe(ex); }
        finally { busy = false; }
    }

    private Task BindAsync(string code)
    {
        if (!Guid.TryParse(bindIds.GetValueOrDefault(code), out var restaurantId))
        {
            error = "Enter a valid restaurant id to bind.";
            return Task.CompletedTask;
        }
        return WriteAsync(() => Api.BindQrCode(code, new BindQrRequest { RestaurantId = restaurantId }));
    }

    private Task UnbindAsync(string code) => WriteAsync(() => Api.UnbindQrCode(code));

    private Task DeleteAsync(string code) => WriteAsync(() => Api.DeleteQrCode(code));

    private async Task WriteAsync(Func<Task> action)
    {
        busy = true;
        error = null;
        message = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) { error = ApiError.Describe(ex); }
        finally { busy = false; }
    }

    private Task PrevAsync()
    {
        offset = Math.Max(0, offset - PageSize);
        return LoadAsync();
    }

    private Task NextAsync()
    {
        offset += PageSize;
        return LoadAsync();
    }
}
