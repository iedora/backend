@page "/alerts"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api

<PageTitle>Alerts — iedora admin</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Needs attention</MudText>

<AsyncData T="StaffAlertsResponse" Load="() => Api.StaffAlerts()" Context="data">
    <MudGrid Spacing="4">
        <MudItem xs="6" sm="4" md="3"><Tile Label="Unbound QR" Value="data.UnboundQr" /></MudItem>
        <MudItem xs="6" sm="4" md="3"><Tile Label="Stale" Value="data.StaleRestaurants.Count" /></MudItem>
        <MudItem xs="6" sm="4" md="3"><Tile Label="Empty menus" Value="data.EmptyMenus.Count" /></MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">
        Stale restaurants <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true">(a week old, no recent views)</MudText>
    </MudText>
    <RestaurantList Rows="data.StaleRestaurants" Empty="Nothing stale." />

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">
        Empty menus <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true">(no dishes yet)</MudText>
    </MudText>
    <RestaurantList Rows="data.EmptyMenus" Empty="Every restaurant has dishes." />
</AsyncData>
