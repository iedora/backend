@page "/users/{Id:guid}"
@using System.Net
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api
@inject IDialogService Dialogs

<PageTitle>User — iedora admin</PageTitle>

<MudButton Href="/users" Variant="Variant.Text" Size="Size.Small"
           StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Users</MudButton>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
}
else if (data is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1">@data.User.Email</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@data.User.Name — joined @data.User.CreatedAt.ToString("MMM d, yyyy")</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">Roles: <b>@(data.User.Roles.Count == 0 ? "none" : string.Join(", ", data.User.Roles))</b></MudText>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="my-4">
        <MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="ForcePasswordChangeAsync">Force password change</MudButton>
        <MudTextField @bind-Value="newPassword" InputType="InputType.Password" Immediate="true"
                      Placeholder="Temporary password" autocomplete="new-password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px" />
        <MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="SetPasswordAsync">Set password</MudButton>
    </MudStack>
    @if (actionMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@actionMessage</MudAlert>
    }
    @if (actionError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@actionError</MudAlert>
    }

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">Tenants</MudText>
    @if (data.Memberships.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No tenant memberships.</MudText>
    }
    else
    {
        <MudTable Items="data.Memberships" Hover="true" Dense="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>Tenant</MudTh>
                <MudTh>Role</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tenant" Style="color:var(--mud-palette-text-secondary)">@context.TenantId</MudTd>
                <MudTd DataLabel="Role">@context.Role</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">Sessions</MudText>
    @if (data.Sessions.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No sessions.</MudText>
    }
    else
    {
        <MudTable Items="data.Sessions" Hover="true" Dense="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>Device</MudTh>
                <MudTh>IP</MudTh>
                <MudTh>Issued</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Device" Style="color:var(--mud-palette-text-secondary)">@context.UserAgent</MudTd>
                <MudTd DataLabel="IP" Style="color:var(--mud-palette-text-secondary)">@context.Ip</MudTd>
                <MudTd DataLabel="Issued" Style="color:var(--mud-palette-text-secondary)">@context.IssuedAt.ToString("MMM d, HH:mm")</MudTd>
                <MudTd DataLabel="Status">@(context.RevokedAt is null ? "Active" : "Revoked")</MudTd>
                <MudTd Style="text-align:right">
                    @if (context.RevokedAt is null)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Disabled="busy" OnClick="() => RevokeAsync(context.FamilyId)">Revoke</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private StaffUserDetail? data;
    private string? error;
    private bool busy;
    private string newPassword = "";
    private string? actionMessage;
    private string? actionError;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        data = null;
        error = null;
        try { data = await Api.StaffUserDetail(Id); }
        catch (Exception ex) { error = ApiError.Describe(ex); }
    }

    private async Task ForcePasswordChangeAsync()
    {
        if (!await Confirm("Force this user to change their password at next login? It signs them out of every device."))
            return;
        await ActAsync(() => Api.StaffForcePasswordChange(Id), "Password change forced — the user is signed out.");
    }

    private async Task SetPasswordAsync()
    {
        if (string.IsNullOrEmpty(newPassword))
        {
            actionError = "Enter a temporary password.";
            return;
        }
        await ActAsync(
            () => Api.StaffSetUserPassword(Id, new SetUserPasswordRequest { Password = newPassword }),
            "Temporary password set — the user must change it at next login.");
        newPassword = "";
    }

    private Task RevokeAsync(Guid family) => ActAsync(() => Api.StaffRevokeUserSession(Id, family), "Session revoked.");

    private async Task ActAsync(Func<Task> action, string success)
    {
        busy = true;
        actionError = null;
        actionMessage = null;
        try
        {
            await action();
            actionMessage = success;
            await LoadAsync(); // reflect revoked sessions etc.
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            actionError = "That password doesn't meet the requirements.";
        }
        catch (Exception ex) { actionError = ApiError.Describe(ex); }
        finally { busy = false; }
    }

    private async Task<bool> Confirm(string message) =>
        await Dialogs.ShowMessageBoxAsync("Force password change?", message, yesText: "Force", cancelText: "Cancel") == true;
}
