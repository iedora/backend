@page "/login"
@layout Iedora.Dashboard.Components.Layout.EmptyLayout
@using System.Security.Claims
@using Iedora.Identity.Contracts
@attribute [AllowAnonymous]
@inject ApiAuthClient Auth
@inject ApiAuthStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Sign in — iedora admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
    <MudPaper Elevation="2" Class="pa-8 rounded-lg">
        <MudText Typo="Typo.h5" GutterBottom="true">
            <b>iedora</b> <MudText Typo="Typo.h5" Color="Color.Primary" Inline="true"><b>admin</b></MudText>
        </MudText>

        @* LoginForm owns its own validation (EditForm + DataAnnotations); this page owns the busy
           state and the admin-only gate in HandleSubmitAsync. *@
        <LoginForm OnSubmit="HandleSubmitAsync" Busy="busy" />

        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@error</MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private string? error;
    private bool busy;

    private async Task HandleSubmitAsync((string Email, string Password) credentials)
    {
        busy = true;
        error = null;

        var token = await Auth.LoginAsync(credentials.Email, credentials.Password, CancellationToken.None);
        if (token is null)
        {
            error = "Incorrect email or password.";
            busy = false;
            return;
        }

        // Admin console — only platform admins may enter. Don't leave a live session for a non-admin.
        if (!Jwt.ReadClaims(token).Any(c => c.Type == ClaimTypes.Role && c.Value == Roles.Admin))
        {
            await Auth.LogoutAsync(CancellationToken.None);
            error = "That account isn't a platform admin.";
            busy = false;
            return;
        }

        AuthState.SignedIn(token);
        Nav.NavigateTo("/");
    }
}
