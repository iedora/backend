@page "/directory"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api
@inject NavigationManager Nav

<PageTitle>Directory — iedora admin</PageTitle>

<h1>Restaurant directory</h1>

<form class="search" @onsubmit="Search" @onsubmit:preventDefault>
    <input placeholder="Search name or slug…" @bind="_q" @bind:event="oninput" />
    <button type="submit">Search</button>
</form>

<AsyncData T="StaffDirectoryResponse" Key="@Q" Load="() => Api.StaffDirectory(Q ?? string.Empty)" Context="d">
    <RestaurantList Rows="d.Restaurants" Empty="No restaurants match." />
</AsyncData>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    private string _q = "";

    protected override void OnParametersSet() => _q = Q ?? "";

    // Reflect the search in the URL (bookmarkable/shareable); the ?q param drives the reload via Key.
    private void Search() => Nav.NavigateTo(_q.Length == 0 ? "directory" : $"directory?q={Uri.EscapeDataString(_q)}");
}
