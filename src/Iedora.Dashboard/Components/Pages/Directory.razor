@page "/directory"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api

<PageTitle>Directory — iedora admin</PageTitle>

<h1>Restaurant directory</h1>

<form class="search" @onsubmit="Reload" @onsubmit:preventDefault>
    <input placeholder="Search name or slug…" @bind="query" @bind:event="oninput" />
    <button type="submit">Search</button>
</form>

<AsyncData T="StaffDirectoryResponse" Load="() => Api.StaffDirectory(query)" @ref="_data" Context="d">
    <RestaurantList Rows="d.Restaurants" Empty="No restaurants match." />
</AsyncData>

@code {
    private string query = "";
    private AsyncData<StaffDirectoryResponse> _data = default!;

    private Task Reload() => _data.ReloadAsync();
}
