@page "/directory"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api
@inject NavigationManager Nav

<PageTitle>Directory — iedora admin</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Restaurant directory</MudText>

<SearchBar Query="@Q" Placeholder="Search name or slug…" OnSearch="Search" />

<AsyncData T="StaffDirectoryResponse" Key="@Q" Load="() => Api.StaffDirectory(Q ?? string.Empty)" Context="d">
    <RestaurantList Rows="d.Restaurants" Empty="No restaurants match." />
</AsyncData>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    // Reflect the search in the URL (bookmarkable/shareable); the ?q param drives the reload via Key.
    private void Search(string q) => Nav.NavigateTo(q.Length == 0 ? "directory" : $"directory?q={Uri.EscapeDataString(q)}");
}
