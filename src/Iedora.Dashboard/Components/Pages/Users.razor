@page "/users"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api
@inject NavigationManager Nav

<PageTitle>Users — iedora admin</PageTitle>

<h1>Users</h1>

<form class="search" @onsubmit="Search" @onsubmit:preventDefault>
    <input placeholder="Search email or name…" @bind="_q" @bind:event="oninput" />
    <button type="submit">Search</button>
</form>

<AsyncData T="StaffUserListResponse" Key="@Q" Load="() => Api.StaffListUsers(Q ?? string.Empty, null)" Context="d">
    @if (d.Users.Count == 0)
    {
        <p class="muted">No users match.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Email</th><th>Name</th><th>Roles</th><th>Joined</th></tr></thead>
            <tbody>
                @* Virtualize against the page scroll (SpacerElement=tr keeps the table valid). Small
                   lists render fully; a large user base only materializes the visible rows. *@
                <Virtualize Items="d.Users" SpacerElement="tr">
                    <ItemContent Context="u">
                        <tr>
                            <td><a href="/users/@u.Id">@u.Email</a></td>
                            <td>@u.Name</td>
                            <td class="muted">@string.Join(", ", u.Roles)</td>
                            <td class="muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    </ItemContent>
                </Virtualize>
            </tbody>
        </table>
    }
</AsyncData>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    private string _q = "";

    protected override void OnParametersSet() => _q = Q ?? "";

    private void Search() => Nav.NavigateTo(_q.Length == 0 ? "users" : $"users?q={Uri.EscapeDataString(_q)}");
}
