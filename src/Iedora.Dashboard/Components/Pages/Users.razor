@page "/users"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api
@inject NavigationManager Nav

<PageTitle>Users — iedora admin</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Users</MudText>

<SearchBar Query="@Q" Placeholder="Search email or name…" OnSearch="Search" />

<AsyncData T="StaffUserListResponse" Key="@Q" Load="() => Api.StaffListUsers(Q ?? string.Empty, null)" Context="d">
    @if (d.Users.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No users match.</MudText>
    }
    else
    {
        @* Virtualize keeps a large user base to just the visible rows; Height gives it a scroll box. *@
        <MudTable Items="d.Users" Hover="true" Dense="true" Outlined="true" Elevation="0"
                  Virtualize="true" Height="60vh" FixedHeader="true">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Joined</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email"><MudLink Href="@($"/users/{context.Id}")">@context.Email</MudLink></MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Roles" Style="color:var(--mud-palette-text-secondary)">@string.Join(", ", context.Roles)</MudTd>
                <MudTd DataLabel="Joined" Style="color:var(--mud-palette-text-secondary)">@context.CreatedAt.ToString("MMM d, yyyy")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</AsyncData>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    // The ?q param drives the reload (AsyncData.Key); Search just reflects the box into the URL.
    private void Search(string q) => Nav.NavigateTo(q.Length == 0 ? "users" : $"users?q={Uri.EscapeDataString(q)}");
}
