@page "/restaurants/{Id:guid}"
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api

<PageTitle>Restaurant — iedora admin</PageTitle>

<MudButton Href="/directory" Variant="Variant.Text" Size="Size.Small"
           StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Directory</MudButton>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
}
else if (data is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1">@data.Restaurant.Name</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary" GutterBottom="true">
        @data.Restaurant.Slug · <MudLink Href="@($"/restaurants/{Id}/menus")">Edit menu JSON</MudLink>
    </MudText>

    <MudGrid Spacing="4" Class="mt-2">
        <MudItem xs="6" sm="4"><Tile Label="Menus" Value="data.Restaurant.Menus" /></MudItem>
        <MudItem xs="6" sm="4"><Tile Label="Items" Value="data.Restaurant.Items" /></MudItem>
        <MudItem xs="6" sm="4"><Tile Label="Views · 30d" Value="data.Restaurant.Views30d" /></MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">Views · last 14 days</MudText>
    @if (data.Trend.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No views yet.</MudText>
    }
    else
    {
        <div class="spark">
            @foreach (var point in data.Trend)
            {
                <div class="spark-bar" style="height:@BarHeight(point.Count)%" title="@point.Day.ToString("MMM d"): @point.Count"></div>
            }
        </div>
    }

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">Menus</MudText>
    @if (data.Menus.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No menus.</MudText>
    }
    else
    {
        <MudTable Items="data.Menus" Hover="true" Dense="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>Menu</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Categories</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Menu">@context.Name</MudTd>
                <MudTd DataLabel="Status">@(context.Active ? "Active" : "Hidden")</MudTd>
                <MudTd DataLabel="Categories" Style="text-align:right">@context.CategoryCount</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private StaffRestaurantDetailResponse? data;
    private string? error;

    private int BarHeight(int count)
    {
        var max = Math.Max(1, data!.Trend.Max(p => p.Count));
        return (int)Math.Round(100.0 * count / max);
    }

    protected override async Task OnParametersSetAsync()
    {
        data = null;
        error = null;
        try { data = await Api.StaffRestaurantDetail(Id); }
        catch (Exception ex) { error = ApiError.Describe(ex); }
    }
}
