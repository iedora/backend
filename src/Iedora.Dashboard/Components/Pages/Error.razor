@page "/error"
@layout Iedora.Dashboard.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Error — iedora admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
    <MudPaper Elevation="2" Class="pa-8 rounded-lg">
        <MudText Typo="Typo.h5" GutterBottom="true">Something went wrong</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            An unexpected error occurred. Try again, or head back to the console.
        </MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Back to the dashboard</MudButton>
    </MudPaper>
</MudContainer>
