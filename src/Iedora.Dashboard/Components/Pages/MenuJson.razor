@page "/restaurants/{Id:guid}/menus"
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@using Iedora.Dashboard.Api
@attribute [Authorize]
@inject IIedoraApiv1 Api
@inject IDialogService Dialogs

<PageTitle>Menu JSON — iedora admin</PageTitle>

<MudButton Href="@($"/restaurants/{Id}")" Variant="Variant.Text" Size="Size.Small"
           StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Restaurant</MudButton>
<MudText Typo="Typo.h4" HtmlTag="h1">Menu JSON</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" GutterBottom="true">
    Export the live menu tree, edit it, and replace it. Importing overwrites the whole tree.
</MudText>

<MudStack Row="true" Spacing="2" Class="my-4">
    <MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="ExportAsync"
               StartIcon="@Icons.Material.Filled.Refresh">Re-export</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@(busy || json is null)" OnClick="ImportAsync"
               StartIcon="@Icons.Material.Filled.Publish">Import (replace)</MudButton>
</MudStack>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@error</MudAlert>
}
@if (message is not null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@message</MudAlert>
}

<div class="json-editor">
    <MudTextField T="string" @bind-Value="json" Immediate="true" Disabled="@(json is null)"
                  Lines="24" Variant="Variant.Outlined" spellcheck="false" />
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private string? json;
    private string? error;
    private string? message;
    private bool busy;

    // Match the API's export shape: indented, camelCase (via the contracts' JsonPropertyName), nulls omitted.
    private static readonly JsonSerializerOptions Pretty = new()
    {
        WriteIndented = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    protected override Task OnParametersSetAsync() => ExportAsync();

    private async Task ExportAsync()
    {
        busy = true;
        error = null;
        message = null;
        try
        {
            var document = await Api.StaffExportMenus(Id);
            json = JsonSerializer.Serialize(document, Pretty);
        }
        catch (Exception ex) { error = ApiError.Describe(ex); }
        finally { busy = false; }
    }

    private async Task ImportAsync()
    {
        if (json is null) return;

        MenuImportDocument? document;
        try { document = JsonSerializer.Deserialize<MenuImportDocument>(json, Pretty); }
        catch (JsonException) { error = "That isn't valid JSON."; message = null; return; }
        if (document is null) { error = "That isn't a menu document."; message = null; return; }

        if (!await Confirm("Replace this restaurant's entire menu tree with the JSON above? This can't be undone."))
            return;

        busy = true;
        error = null;
        message = null;
        try
        {
            await Api.StaffReplaceMenus(Id, document);
            await ExportAsync();          // re-export to show the normalized result
            message = "Menu replaced.";   // after the re-export (which clears messages)
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            error = "The import was rejected — check the menu / category / item counts and translation languages.";
        }
        catch (Exception ex) { error = ApiError.Describe(ex); }
        finally { busy = false; }
    }

    private async Task<bool> Confirm(string prompt) =>
        await Dialogs.ShowMessageBoxAsync("Replace menu?", prompt, yesText: "Replace", cancelText: "Cancel") == true;
}
