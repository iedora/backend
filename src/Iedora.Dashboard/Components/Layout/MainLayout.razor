@inherits LayoutComponentBase
@inject ApiAuthStateProvider AuthState
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="/">iedora <span>admin</span></a>
    <AuthorizeView>
        <nav class="nav">
            <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
            <NavLink href="/directory">Directory</NavLink>
            <NavLink href="/alerts">Alerts</NavLink>
            <NavLink href="/qr-codes">QR</NavLink>
            <NavLink href="/users">Users</NavLink>
        </nav>
        <div class="session">
            <span class="who">@context.User.Identity?.Name</span>
            <button type="button" class="link" @onclick="SignOutAsync">Sign out</button>
        </div>
    </AuthorizeView>
</header>
<main class="content">
    @Body
</main>

@code {
    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        Nav.NavigateTo("/login");
    }
}
