@inherits LayoutComponentBase
@inject ApiAuthStateProvider AuthState
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="/">iedora <span>admin</span></a>
    <AuthorizeView>
        <div class="session">
            <span class="who">@context.User.Identity?.Name</span>
            <button type="button" class="link" @onclick="SignOutAsync">Sign out</button>
        </div>
    </AuthorizeView>
</header>

<main class="content">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        Nav.NavigateTo("/login");
    }
}
