<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iedora.MigrationService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Iedora.ServiceDefaults\Iedora.ServiceDefaults.csproj" />
    <!-- Each module owns its DbContext + migrations; this worker references them all to apply them. -->
    <ProjectReference Include="..\Iedora.Identity\Iedora.Identity.csproj" />
    <ProjectReference Include="..\Iedora.Tenancy\Iedora.Tenancy.csproj" />
    <ProjectReference Include="..\Iedora.Menus\Iedora.Menus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire Npgsql integration for AddNpgsqlDbContext (connection string + retry strategy). -->
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
