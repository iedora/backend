<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iedora.Notifications</RootNamespace>
  </PropertyGroup>
  <!-- The Notifications service: consumes EmailRequested via its own inbox and delivers over SMTP.
       Non-web (no endpoints) — the worker drains it, like a channel dispatcher. -->
  <ItemGroup>
    <ProjectReference Include="..\Iedora.Notifications.Contracts\Iedora.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\framework\Inbox\Framework.Inbox\Framework.Inbox.csproj" />
    <ProjectReference Include="..\..\framework\Outbox\Framework.Outbox\Framework.Outbox.csproj" />
    <ProjectReference Include="..\..\framework\Email\Framework.Email\Framework.Email.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
